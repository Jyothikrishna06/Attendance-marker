# ==============================================================================
# Environment Configuration Template
# SMART HOSTEL CURFEW & MULTI-FACTOR PRESENCE VERIFICATION SYSTEM
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# JWT Cryptographic Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_random_seed_1
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_random_seed_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hostel_curfew

# Rate Limiting Guardrails for Auth Endpoints
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Authorized Campus & Mobile Hotspot Wi-Fi Subnet CIDRs (comma-separated IPv4 CIDR blocks)
# Supports Android (192.168.43.0/24), Jio (192.168.225.0/24), iOS (172.20.10.0/24),
# Windows Hotspot (192.168.137.0/24), CUSAT Wi-Fi (172.29.247.0/24), and Localhost (127.0.0.1/32)
AUTHORIZED_WIFI_CIDRS=192.168.43.0/24,192.168.225.0/24,172.20.10.0/24,192.168.137.0/24,192.168.1.0/24,172.29.247.0/24,10.42.0.0/16,127.0.0.1/32
